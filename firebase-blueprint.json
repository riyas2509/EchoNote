{
  "entities": {
    "UserProfile": {
      "title": "User Profile",
      "description": "EchoNote user account and subscription state.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "name": { "type": "string" },
        "plan": { "type": "string", "enum": ["free", "pro", "team", "enterprise", "guest"] },
        "minutesUsed": { "type": "number" },
        "extraMinutes": { "type": "number" },
        "minutesLimit": { "type": "number" },
        "thinkingUsageCount": { "type": "number" },
        "renewal_date": { "type": "string", "format": "date-time" },
        "billing_cycle": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "plan"]
    },
    "Project": {
      "title": "Project",
      "description": "Collaboration container for recordings.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "name": { "type": "string" },
        "ownerEmail": { "type": "string" },
        "isDefault": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "name"]
    },
    "ProjectMember": {
      "title": "Project Member",
      "description": "Links a user to a project with a role.",
      "type": "object",
      "properties": {
        "projectId": { "type": "string" },
        "userId": { "type": "string" },
        "email": { "type": "string" },
        "role": { "type": "string", "enum": ["owner", "admin", "editor", "commenter", "viewer"] },
        "joinedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["projectId", "userId", "role"]
    },
    "Comment": {
      "title": "Comment",
      "description": "Collaboration comment on a recording or transcript.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "recordingId": { "type": "string" },
        "projectId": { "type": "string" },
        "organizationId": { "type": "string" },
        "userId": { "type": "string" },
        "userEmail": { "type": "string" },
        "userName": { "type": "string" },
        "content": { "type": "string" },
        "timestampSeconds": { "type": "number" },
        "parentCommentId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "recordingId", "projectId", "userId", "userEmail", "userName", "content", "createdAt"]
    },
    "Invitation": {
      "title": "Invitation",
      "description": "Pending project invitation.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "email": { "type": "string" },
        "projectId": { "type": "string" },
        "projectName": { "type": "string" },
        "role": { "type": "string" },
        "invitedBy": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "accepted", "expired"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "email", "projectId", "role"]
    },
    "Recording": {
      "title": "Recording",
      "description": "Audio recording metadata.",
      "type": "object",
      "properties": {
        "recordingId": { "type": "string" },
        "userId": { "type": "string" },
        "projectId": { "type": "string" },
        "audioUrl": { "type": "string" },
        "duration": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["recordingId", "userId", "audioUrl"]
    },
    "Transcription": {
      "title": "Transcription",
      "description": "AI-generated transcription and analysis.",
      "type": "object",
      "properties": {
        "transcriptionId": { "type": "string" },
        "recordingId": { "type": "string" },
        "userId": { "type": "string" },
        "text": { "type": "string" },
        "summary": { "type": "string" },
        "actionItems": { "type": "array", "items": { "type": "string" } },
        "speakers": { "type": "array", "items": { "type": "object" } },
        "confidenceScore": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["transcriptionId", "recordingId", "userId"]
    },
    "Usage": {
      "title": "Usage",
      "description": "Usage tracking for minutes and AI requests.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "minutesUsed": { "type": "number" },
        "aiRequestsUsed": { "type": "number" },
        "lastUpdated": { "type": "string", "format": "date-time" }
      },
      "required": ["userId"]
    },
    "HealthCheck": {
      "title": "Health Check",
      "description": "Simple status check.",
      "type": "object",
      "properties": {
        "status": { "type": "string" }
      },
      "required": ["status"]
    },
    "DecisionHistory": {
      "title": "Decision History",
      "description": "AI-analyzed decision insights and thinking engine history.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "inputType": { "type": "string", "enum": ["transcript", "summary"] },
        "inputText": { "type": "string" },
        "output": { "type": "object" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "title", "inputType", "inputText", "output"]
    },
    "AIUsageLog": {
      "title": "AI Usage Log",
      "description": "Granular individual AI request token and cost metrics.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "plan": { "type": "string" },
        "featureName": { "type": "string" },
        "modelUsed": { "type": "string" },
        "inputTokens": { "type": "number" },
        "outputTokens": { "type": "number" },
        "totalTokens": { "type": "number" },
        "estimatedCost": { "type": "number" },
        "requestDuration": { "type": "number" },
        "status": { "type": "string", "enum": ["success", "failure"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "email", "featureName", "modelUsed", "inputTokens", "outputTokens", "totalTokens", "estimatedCost", "requestDuration", "status"]
    },
    "UserCostAnalytics": {
      "title": "User Cost Analytics",
      "description": "Aggregated AI cost and usage summaries tracked per individual user.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "plan": { "type": "string" },
        "totalRequests": { "type": "number" },
        "totalInputTokens": { "type": "number" },
        "totalOutputTokens": { "type": "number" },
        "totalTokens": { "type": "number" },
        "totalEstimatedCost": { "type": "number" },
        "lastUpdated": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "email", "plan", "totalRequests", "totalInputTokens", "totalOutputTokens", "totalTokens", "totalEstimatedCost"]
    },
    "UserAnalytics": {
      "title": "User Analytics",
      "description": "Rich extended granular user metrics for backend intelligence.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "plan": { "type": "string" },
        "displayName": { "type": "string" },
        "transcriptionMinutesUsed": { "type": "number" },
        "intelligenceRequestsUsed": { "type": "number" },
        "totalAIRequests": { "type": "number" },
        "totalInputTokens": { "type": "number" },
        "totalOutputTokens": { "type": "number" },
        "totalTokens": { "type": "number" },
        "totalAICost": { "type": "number" },
        "monthlyAICost": { "type": "number" },
        "lifetimeAICost": { "type": "number" },
        "subscriptionRevenue": { "type": "number" },
        "topupRevenue": { "type": "number" },
        "lifetimeRevenue": { "type": "number" },
        "revenueMinusCost": { "type": "number" },
        "lastActiveAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "email", "plan"]
    },
    "TeamAnalytics": {
      "title": "Team Analytics",
      "description": "Aggregated team-wide metrics and profitability analysis.",
      "type": "object",
      "properties": {
        "teamId": { "type": "string" },
        "teamName": { "type": "string" },
        "totalMembers": { "type": "number" },
        "totalMinutesUsed": { "type": "number" },
        "totalInputTokens": { "type": "number" },
        "totalOutputTokens": { "type": "number" },
        "totalTokens": { "type": "number" },
        "totalAIRequests": { "type": "number" },
        "totalAICost": { "type": "number" },
        "totalRevenue": { "type": "number" },
        "profitability": { "type": "number" }
      },
      "required": ["teamId", "teamName"]
    },
    "MonthlyAnalytics": {
      "title": "Monthly Analytics",
      "description": "Summarized month-by-month platform statistics.",
      "type": "object",
      "properties": {
        "month": { "type": "string" },
        "totalUsers": { "type": "number" },
        "activeUsers": { "type": "number" },
        "totalMinutes": { "type": "number" },
        "totalInputTokens": { "type": "number" },
        "totalOutputTokens": { "type": "number" },
        "totalTokens": { "type": "number" },
        "totalAISpend": { "type": "number" },
        "totalRevenue": { "type": "number" },
        "profitEstimate": { "type": "number" }
      },
      "required": ["month"]
    },
    "FeatureAnalytics": {
      "title": "Feature Analytics",
      "description": "Separate cost tracking aggregated per distinctive AI feature.",
      "type": "object",
      "properties": {
        "featureName": { "type": "string" },
        "totalRequests": { "type": "number" },
        "totalInputTokens": { "type": "number" },
        "totalOutputTokens": { "type": "number" },
        "totalTokens": { "type": "number" },
        "totalAICost": { "type": "number" },
        "totalResponseTime": { "type": "number" }
      },
      "required": ["featureName"]
    },
    "Transaction": {
      "title": "Transaction",
      "description": "Payment transactions and billing invoices.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "paymentId": { "type": "string" },
        "orderId": { "type": "string" },
        "type": { "type": "string", "enum": ["subscription", "topup", "downgrade"] },
        "planId": { "type": "string" },
        "billingCycle": { "type": "string" },
        "amount": { "type": "number" },
        "minutes": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "status": { "type": "string" }
      },
      "required": ["userId", "amount", "createdAt"]
    },
    "Organization": {
      "title": "Organization",
      "description": "Corporate organization settings and Enterprise Security Center policies.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "logoUrl": { "type": "string" },
        "ownerEmail": { "type": "string" },
        "industry": { "type": "string" },
        "timezone": { "type": "string" },
        "country": { "type": "string" },
        "language": { "type": "string" },
        "defaultWorkspace": { "type": "string" },
        "brandColor": { "type": "string" },
        "settings": {
          "type": "object",
          "properties": {
            "enforceMfa": { "type": "boolean" },
            "sessionTimeoutMinutes": { "type": "number" },
            "logoUrl": { "type": "string" },
            "industry": { "type": "string" },
            "timezone": { "type": "string" },
            "country": { "type": "string" },
            "language": { "type": "string" },
            "defaultWorkspace": { "type": "string" },
            "brandColor": { "type": "string" }
          }
        },
        "securitySettings": {
          "type": "object",
          "properties": {
            "googleAuthEnabled": { "type": "boolean" },
            "googleClientId": { "type": "string" },
            "googleClientSecret": { "type": "string" },
            "microsoftAuthEnabled": { "type": "boolean" },
            "microsoftClientId": { "type": "string" },
            "microsoftClientSecret": { "type": "string" },
            "ssoStatus": { "type": "string" },
            "ssoProtocol": { "type": "string" },
            "ssoIdpUrl": { "type": "string" },
            "samlStatus": { "type": "string" },
            "samlEntityId": { "type": "string" },
            "samlSsoUrl": { "type": "string" },
            "samlCertificate": { "type": "string" },
            "pwdMinLength": { "type": "number" },
            "pwdEnforceSpecial": { "type": "boolean" },
            "pwdEnforceNumbers": { "type": "boolean" },
            "pwdMaxAge": { "type": "number" },
            "twoFactorStatus": { "type": "string" },
            "sessionTimeout": { "type": "string" },
            "allowedDomains": { "type": "string" },
            "blockedDomains": { "type": "string" },
            "apiKeys": { "type": "array" },
            "securityEvents": { "type": "array" },
            "auditLogs": { "type": "array" }
          }
        }
      },
      "required": ["id", "name", "ownerEmail"]
    },
    "AuditLog": {
      "title": "AuditLog",
      "description": "Enterprise audit log tracking system actions.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "action": { "type": "string" },
        "actor": { "type": "string" },
        "project": { "type": "string" },
        "organization": { "type": "string" },
        "ip": { "type": "string" },
        "details": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "action", "actor", "timestamp"]
    },
    "Integration": {
      "title": "Integration",
      "description": "Third-party enterprise integration configuration.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "enabled": { "type": "boolean" },
        "status": { "type": "string", "enum": ["connected", "disconnected"] },
        "config": { "type": "object" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "enabled", "status"]
    },
    "Task": {
      "title": "Task",
      "description": "Collaborative project task assigned to team members.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "projectId": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "assigneeEmail": { "type": "string" },
        "assigneeName": { "type": "string" },
        "assigneeId": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "in_progress", "completed"] },
        "priority": { "type": "string", "enum": ["low", "medium", "high", "urgent"] },
        "dueDate": { "type": "string" },
        "subTasks": { "type": "array", "items": { "type": "object" } },
        "activityHistory": { "type": "array", "items": { "type": "object" } },
        "createdBy": { "type": "string" },
        "creatorEmail": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["projectId", "title", "assigneeEmail", "status"]
    },
    "Notification": {
      "title": "Notification",
      "description": "User notification for task assignments and system events.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "userEmail": { "type": "string" },
        "title": { "type": "string" },
        "message": { "type": "string" },
        "type": { "type": "string", "enum": ["audio", "text", "error", "success", "info"] },
        "projectId": { "type": "string" },
        "taskId": { "type": "string" },
        "isRead": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "message", "isRead"]
    }
  },
  "firestore": {
    "/users/{userId}": { "schema": "UserProfile", "description": "User profiles" },
    "/transactions/{id}": { "schema": "Transaction", "description": "Billing and invoice transactions" },
    "/projects/{projectId}": { "schema": "Project", "description": "Collaboration projects" },
    "/recordings/{recordingId}": { "schema": "Recording", "description": "Audio recordings" },
    "/transcriptions/{transcriptionId}": { "schema": "Transcription", "description": "AI transcriptions" },
    "/tasks/{taskId}": { "schema": "Task", "description": "Collaborative assigned project tasks" },
    "/notifications/{id}": { "schema": "Notification", "description": "In-app notifications" },
    "/usage/{userId}": { "schema": "Usage", "description": "Usage tracking" },
    "/subscriptions/{id}": { "schema": "Subscription", "description": "Razorpay subscriptions" },
    "/projectMembers/{id}": { "schema": "ProjectMember", "description": "Project membership" },
    "/comments/{id}": { "schema": "Comment", "description": "Collaboration comments on recordings" },
    "/invites/{id}": { "schema": "Invitation", "description": "Project invitations" },
    "/userIntegrations/{userId}": { "schema": "UserIntegration", "description": "Third-party integrations" },
    "/jiraStates/{userId}": { "schema": "JiraState", "description": "Jira OAuth state" },
    "/healthcheck/{id}": { "schema": "HealthCheck", "description": "System health check" },
    "/decisionHistory/{id}": { "schema": "DecisionHistory", "description": "Thinking engine history" },
    "/aiUsageLogs/{id}": { "schema": "AIUsageLog", "description": "Granular AI usage logs" },
    "/userCostAnalytics/{userId}": { "schema": "UserCostAnalytics", "description": "Aggregated user cost analytics" },
    "/userAnalytics/{userId}": { "schema": "UserAnalytics", "description": "Aggregated user rich analytics" },
    "/teamAnalytics/{teamId}": { "schema": "TeamAnalytics", "description": "Aggregated team cost analytics" },
    "/monthlyAnalytics/{month}": { "schema": "MonthlyAnalytics", "description": "Monthly aggregates analytics document" },
    "/featureAnalytics/{featureId}": { "schema": "FeatureAnalytics", "description": "Feature usage and latency statistics" },
    "/organizations/{orgId}": { "schema": "Organization", "description": "Corporate organizations" },
    "/organizations/{orgId}/monthlyTrends/{trendId}": { "schema": "MonthlyAnalytics", "description": "Month-by-month financial and usage trends of the organization" },
    "/organizations/{orgId}/auditLogs/{id}": { "schema": "AuditLog", "description": "Granular enterprise audit logs" },
    "/organizations/{orgId}/integrations/{id}": { "schema": "Integration", "description": "Third-party enterprise integration configurations" },
    "/departments/{deptId}": { "schema": "Department", "description": "Created organizational divisions" },
    "/orgMembers/{memberId}": { "schema": "OrgMember", "description": "Employees registered to the organization" },
    "/orgInvitations/{inviteId}": { "schema": "OrgInvitation", "description": "History of corporate invitations" }
  }
}
