# ==============================================================================#
# EchoNote Dedicated Gemini Canary Container (Step 3B.4U-AG)
# ==============================================================================#
# Minimal, isolated multi-stage container image for Google Cloud Run.
# - Base image: Node.js 22 LTS (Active Long Term Support).
# - ZERO bundling or execution of server.ts or production frontend (Vite).
# - ZERO FFmpeg installation (Gemini canary processes pure Base64 audio directly).
# - ZERO production database, billing, email, or scheduled worker dependencies.
# - Runs as a non-root user (node:node, UID/GID 1000).
# ==============================================================================#

# ------------------------------------------------------------------------------
# Stage 1: Build stage
# ------------------------------------------------------------------------------
FROM node:22-slim AS builder

WORKDIR /app

# Copy root package manifests for build-time esbuild dependencies
COPY package*.json ./

# Install development dependencies needed to run esbuild
RUN npm ci

# Copy only canary source and TypeScript configuration
COPY canary/ ./canary/
COPY tsconfig.json ./

# Compile standalone canary into dist/canary.cjs using esbuild targeting Node 22
RUN npx esbuild canary/gemini-canary.ts \
    --bundle \
    --platform=node \
    --target=node22 \
    --format=cjs \
    --packages=external \
    --outfile=dist/canary.cjs

# ------------------------------------------------------------------------------
# Stage 2: Minimal Production Runner stage
# ------------------------------------------------------------------------------
FROM node:22-slim AS runner

WORKDIR /app

# Ensure CA certificates are up to date for secure outbound TLS to Google APIs
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

ENV NODE_ENV=production
ENV PORT=3000
ENV RUN_CANARY_SERVER=true

# Copy dedicated canary dependency manifests
COPY canary/package.canary.json ./package.json
COPY canary/package-lock.canary.json ./package-lock.json

# Install strictly the isolated canary runtime dependencies
RUN npm ci --omit=dev && npm cache clean --force

# Copy only the compiled standalone canary bundle from builder
COPY --from=builder /app/dist/canary.cjs ./dist/canary.cjs

# Run as non-root user provided by node base image
USER node

# Cloud Run injects PORT dynamically (typically 8080)
EXPOSE 3000

# Execute strictly the standalone canary service
CMD ["node", "dist/canary.cjs"]
