# ==============================================================================
# EchoNote Production & Local Environment Configuration
# ==============================================================================

# Backend Server Port (Cloud Run injects PORT dynamically; defaults to 3000)
PORT=3000

# CORS Allowed Origins (Comma-separated list for Vercel frontend and custom domains)
ALLOWED_ORIGINS=https://echonote-25.vercel.app,https://echotechai.in,https://www.echotechai.in

# Public Canonical Application URL (Authoritative base URL for email invitation deep-links)
# In production, set to your canonical public domain (e.g. https://echonote-25.ai.studio) or deployed web app URL.
APP_URL=https://echonote-25.ai.studio

# Razorpay API Credentials (Razorpay Dashboard > Settings > API Keys)
# Mode: set to 'live' or 'test' (optional; auto-detected from key prefix if omitted)
RAZORPAY_MODE=live
# Use rzp_test_... for Test Mode or rzp_live_... for Live Mode
RAZORPAY_KEY_ID=rzp_live_[YOUR_KEY_ID]
RAZORPAY_KEY_SECRET=[SET_VIA_SECRET_MANAGER]
RAZORPAY_WEBHOOK_SECRET=[SET_VIA_SECRET_MANAGER]

# Razorpay Recurring Plan IDs (Razorpay Dashboard > Subscriptions > Plans)
# NOTE: Must be Razorpay Plan IDs (e.g. plan_xxx), NOT subscription IDs (sub_xxx)
RAZORPAY_PRO_MONTHLY_PLAN_ID=plan_TambUyuTkGL4zY
RAZORPAY_PRO_YEARLY_PLAN_ID=plan_Tamd1Ef89GKQNk
RAZORPAY_TEAM_MONTHLY_PLAN_ID=plan_TamdizBJ9W7kJo
RAZORPAY_TEAM_YEARLY_PLAN_ID=plan_TameI4cjPUzRpn

# Google Gemini API Key (Server-side only — managed via Secret Manager in production)
GEMINI_API_KEY=[SET_VIA_SECRET_MANAGER]

# Resend Email API Key (Server-side only — managed via Secret Manager in production)
RESEND_API_KEY=[SET_VIA_SECRET_MANAGER]

# Resend Email Sender (Canonical production from address using verified domain)
RESEND_FROM_EMAIL=EchoNote <no-reply@echotechai.in>

# Internal Operations Secrets (Server-side only — managed via Secret Manager in production)
CRON_SECRET=[SET_VIA_SECRET_MANAGER]
PLAYBACK_SECRET=[SET_VIA_SECRET_MANAGER]

# Firebase Backend Project Identification
GOOGLE_CLOUD_PROJECT=echonote-2509

# Frontend Backend API Target (REQUIRED for Vercel production frontend deployment)
# In production on Vercel (Project Settings -> Environment Variables), set this to your
# deployed Google Cloud Run Express service URL:
# VITE_API_URL=https://echonote-200551109142.us-west1.run.app
# IMPORTANT:
# 1. Vite embeds VITE_* variables into the client bundle at BUILD TIME on Vercel.
#    A frontend redeploy is required after setting or changing this variable.
# 2. DO NOT point this to your Vercel frontend domain (echotechai.in).
# 3. If omitted, relative /api requests hit Vercel's SPA catch-all rewrite and return HTML.
VITE_API_URL=https://echonote-200551109142.us-west1.run.app

# Client-Side Firebase Configuration (Required for Web / Vercel frontend)
VITE_FIREBASE_API_KEY=[YOUR_FIREBASE_API_KEY]
VITE_FIREBASE_AUTH_DOMAIN=echonote-2509.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=echonote-2509
VITE_FIREBASE_STORAGE_BUCKET=echonote-2509.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=200551109142
VITE_FIREBASE_APP_ID=[YOUR_FIREBASE_APP_ID]

# Google Cloud Identity Platform (Phase 1.5A Enterprise SSO)
IDENTITY_PLATFORM_ENABLED=true
IDENTITY_PLATFORM_PROJECT_ID=echonote-2509
IDENTITY_PLATFORM_API_KEY=[YOUR_IDENTITY_PLATFORM_API_KEY]
