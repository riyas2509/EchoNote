# ==============================================================================
# EchoNote Production & Local Environment Configuration
# ==============================================================================

# Backend Server Port (Cloud Run injects PORT dynamically; defaults to 3000)
PORT=3000

# CORS Allowed Origins (Comma-separated list for Vercel frontend and custom domains)
ALLOWED_ORIGINS=https://echonote-25.vercel.app,https://echotechai.in,https://www.echotechai.in

# Public Canonical Application URL (Authoritative base URL for email invitation deep-links)
# In production, set to your canonical public domain (e.g. https://echonote-25.ai.studio) or deployed web app URL.
APP_URL=https://echonote-25.vercel.app

# Razorpay API Credentials (Razorpay Dashboard > Settings > API Keys)
# Mode: set to 'live' or 'test' (optional; auto-detected from key prefix if omitted)
RAZORPAY_MODE=live
# Use rzp_test_... for Test Mode or rzp_live_... for Live Mode
RAZORPAY_KEY_ID=rzp_live_[YOUR_KEY_ID]
RAZORPAY_KEY_SECRET=[SET_VIA_SECRET_MANAGER]
RAZORPAY_WEBHOOK_SECRET=[SET_VIA_SECRET_MANAGER]

# Razorpay Recurring Plan IDs (Razorpay Dashboard > Subscriptions > Plans)
# NOTE: Must be Razorpay Plan IDs (e.g. plan_xxx), NOT subscription IDs (sub_xxx)
RAZORPAY_PRO_MONTHLY_PLAN_ID=plan_TambUyuTkGL4zY
RAZORPAY_PRO_YEARLY_PLAN_ID=plan_Tamd1Ef89GKQNk
RAZORPAY_TEAM_MONTHLY_PLAN_ID=plan_TamdizBJ9W7kJo
RAZORPAY_TEAM_YEARLY_PLAN_ID=plan_TameI4cjPUzRpn

# Google Gemini API Key (Server-side only — managed via Secret Manager in production)
GEMINI_API_KEY=[SET_VIA_SECRET_MANAGER]

# Resend Email API Key (Server-side only — managed via Secret Manager in production)
RESEND_API_KEY=[SET_VIA_SECRET_MANAGER]

# Resend Email Sender (Canonical production from address using verified domain)
RESEND_FROM_EMAIL=EchoNote <invitations@echotechai.in>

# Internal Operations Secrets (Server-side only — managed via Secret Manager in production)
CRON_SECRET=[SET_VIA_SECRET_MANAGER]
PLAYBACK_SECRET=[SET_VIA_SECRET_MANAGER]
MFA_RECOVERY_PEPPER=[SET_VIA_SECRET_MANAGER]

# Cloud Scheduler OIDC Authentication (Zero-Secret Service Account Verification)
# Audience expected in Google-issued OIDC tokens from Cloud Scheduler (e.g. canonical Cloud Run service URL)
# SCHEDULER_OIDC_AUDIENCE=https://echonote-zfo2izdqla-uw.a.run.app
# Authorized dedicated service account email allowed to invoke scheduler endpoints
# SCHEDULER_SERVICE_ACCOUNT=echonote-scheduler-invoker@echonote-2509.iam.gserviceaccount.com

# Integration Credential Encryption (AES-256-GCM 32-byte key: 64 hex chars or 44 base64 chars)
# In production on Cloud Run, mapped from Secret Manager: echonote-integration-encryption-key:latest
INTEGRATION_ENCRYPTION_KEY=[SET_VIA_SECRET_MANAGER]

# Active Encryption Key Version Identifier (defaults to 'v1', producing keyId 'local-aes-256-gcm:v1')
# Set to 'v2', 'v3', etc. when rotating active encryption keys.
INTEGRATION_ENCRYPTION_KEY_VERSION=v1

# Controlled Previous Keyring for Safe Rotation (JSON object or comma-separated pairs: v1=<key>,v2=<key>)
# Retains historical keys so existing encrypted records remain decryptable after key rotation.
# Accepts a JSON mapping from canonical key IDs to environment-variable names or securely supplied key values:
# Examples: {"v1":"[PREVIOUS_32_BYTE_KEY_HEX_OR_BASE64]"} or {"v1":"PREVIOUS_KEY_SECRET_ENV_VAR"}
INTEGRATION_ENCRYPTION_PREVIOUS_KEYS=[OPTIONAL_SET_DURING_KEY_ROTATION]

# Atlassian Jira OAuth 2.0 (Cloud Functions API integration)
# Register OAuth 2.0 (3LO) app at https://developer.atlassian.com/console/myapps/
# Scopes required: read:jira-work, write:jira-work, read:jira-user, offline_access
# JIRA_CLIENT_ID=[SET_VIA_SECRET_MANAGER]
# JIRA_CLIENT_SECRET=[SET_VIA_SECRET_MANAGER]
# JIRA_REDIRECT_URI=https://echonote-2509.web.app/auth/jira/callback

# Zoom Video Communications Integration (Phase 1B Meeting Ingestion)
# Webhook verification secret token from Zoom Marketplace (Webhook-Only App or Server-to-Server OAuth App)
# In production on Cloud Run, mapped from Secret Manager: echonote-zoom-webhook-secret:latest
# Requires Secret Accessor permission on Cloud Run service account: 200551109142-compute@developer.gserviceaccount.com
ZOOM_WEBHOOK_SECRET=[SET_VIA_SECRET_MANAGER]

# Firebase Backend Project Identification
GOOGLE_CLOUD_PROJECT=echonote-2509

# Frontend Backend API Target (REQUIRED for Vercel production frontend deployment)
# In production on Vercel (Project Settings -> Environment Variables), set this to your
# deployed Google Cloud Run Express service URL:
# VITE_API_URL=https://echonote-zfo2izdqla-uw.a.run.app
# IMPORTANT:
# 1. Vite embeds VITE_* variables into the client bundle at BUILD TIME on Vercel.
#    A frontend redeploy is required after setting or changing this variable.
# 2. DO NOT point this to your Vercel frontend domain (echotechai.in).
# 3. If omitted, relative /api requests hit Vercel's SPA catch-all rewrite and return HTML.
VITE_API_URL=https://echonote-zfo2izdqla-uw.a.run.app

# Client-Side Firebase Configuration (Required for Web / Vercel frontend)
VITE_FIREBASE_API_KEY=[YOUR_FIREBASE_API_KEY]
VITE_FIREBASE_AUTH_DOMAIN=echonote-2509.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=echonote-2509
VITE_FIREBASE_STORAGE_BUCKET=echonote-2509.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=200551109142
VITE_FIREBASE_APP_ID=[YOUR_FIREBASE_APP_ID]

# Google Cloud Identity Platform (Phase 1.5A Enterprise SSO)
IDENTITY_PLATFORM_ENABLED=true
IDENTITY_PLATFORM_PROJECT_ID=echonote-2509
IDENTITY_PLATFORM_API_KEY=[YOUR_IDENTITY_PLATFORM_API_KEY]

# MFA Recovery Code Server Pepper (Step 3B.4)
# REQUIRED in production and any environment supporting MFA recovery code generation, verification, or ticket issuance.
# Security Requirements & Invariants:
# 1. Must be a cryptographically random, high-entropy secret (e.g., 64 hex characters or 44 base64 characters).
# 2. Must contain at least 32 characters under the current validator; whitespace-only or short strings fail closed.
# 3. Must be configured securely and consistently across all instances/containers in each environment.
# 4. Must NOT be generated afresh at application startup; persistent configuration is mandatory.
# 5. Rotating or changing this secret invalidates all existing recovery-code verifiers in Firestore and all outstanding recovery tickets.
# 6. Never commit a real secret or copy values from runtime environments into version control.
MFA_RECOVERY_PEPPER=[YOUR_32_CHAR_MINIMUM_HIGH_ENTROPY_PEPPER]

