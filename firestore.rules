rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && 
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function isDocOwner() {
      return isAuthenticated() && request.auth.uid == resource.data.userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128;
    }

    function isProjectOwner(projectId) {
      return isAuthenticated() && get(/databases/$(database)/documents/projects/$(projectId)).data.userId == request.auth.uid;
    }

    function isProjectMember(projectId) {
      return isAuthenticated() && (
        // Check if owner
        (exists(/databases/$(database)/documents/projects/$(projectId)) && 
         get(/databases/$(database)/documents/projects/$(projectId)).data.userId == request.auth.uid) ||
        // Check if member
        exists(/databases/$(database)/documents/projectMembers/$(request.auth.uid + "_" + projectId))
      );
    }

    // User Profiles
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow write: if isOwner(userId);
    }
    
    // Projects
    match /projects/{projectId} {
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid || 
        isProjectMember(projectId)
      );
      allow write: if isAuthenticated() && (resource == null || resource.data.userId == request.auth.uid);
    }

    // Project Members
    match /projectMembers/{memberId} {
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid || 
        resource.data.ownerId == request.auth.uid ||
        isProjectMember(resource.data.projectId) ||
        // Double check for ownership/membership via ID
        memberId.startsWith(request.auth.uid + "_") ||
        isProjectOwner(resource.data.projectId)
      );
      allow create: if isAuthenticated() && 
        request.resource.data.userId == request.auth.uid;
      allow delete: if isAuthenticated() && (
        resource.data.userId == request.auth.uid || 
        isProjectOwner(resource.data.projectId)
      );
    }

    // Invitations
    match /invites/{inviteId} {
      allow read: if true; // Needed for join page validation before login if needed, or just let everyone see if they have the token
      allow create: if isAuthenticated(); // Ideally check if project owner
      allow update: if isAuthenticated() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']);
    }
    
    // Recordings
    match /recordings/{recordingId} {
       allow read: if isProjectMember(resource.data.group) || isProjectMember(resource.data.projectId) || isOwner(resource.data.userId);
       allow write: if isAuthenticated() && (resource == null || isProjectMember(request.resource.data.projectId) || isOwner(request.resource.data.userId));
    }
    
    // Transcriptions
    match /transcriptions/{transcriptionId} {
       allow read: if isProjectMember(resource.data.group) || isProjectMember(resource.data.projectId) || isOwner(resource.data.userId);
       allow write: if isAuthenticated() && (resource == null || isProjectMember(request.resource.data.projectId) || isOwner(request.resource.data.userId));
    }
    
    // Usage
    match /usage/{userId} {
      allow read: if isOwner(userId);
      allow write: if isOwner(userId);
    }

    // Decision History
    match /decisionHistory/{id} {
      function isValidDecisionHistory(data) {
        return data.userId == request.auth.uid &&
               data.title is string && data.title.size() <= 500 &&
               data.inputType in ['transcript', 'summary'] &&
               data.inputText is string && data.inputText.size() <= 2000000 &&
               data.output is map;
      }
      
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid);
      allow create: if isAuthenticated() && isValidDecisionHistory(request.resource.data) && (request.resource.data.createdAt == request.time || request.resource.data.createdAt == null);
      allow update: if false; // Decisions are immutable record of analysis
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }
    
    // Subscriptions
    match /subscriptions/{id} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow write: if false; // Only server-side or admin
    }

    // Project Activities
    match /projectActivities/{id} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow delete: if isAuthenticated() && (resource.data.userId == request.auth.uid || isProjectOwner(resource.data.projectId));
    }
    
    // Health Check
    match /healthcheck/{id} {
      allow read: if true;
      allow write: if false;
    }

    // AI Usage Logs (Admin only, secure read access, no client writes)
    match /aiUsageLogs/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // User Cost Analytics (Admin only, secure aggregate read access, no client writes)
    match /userCostAnalytics/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Extended User Analytics (Admin only, secure aggregate read access, no client writes)
    match /userAnalytics/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Team Analytics (Admin only, secure aggregate read access, no client writes)
    match /teamAnalytics/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Monthly platform analytics (Admin only, secure aggregate read access, no client writes)
    match /monthlyAnalytics/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Feature Analytics (Admin only, secure aggregate read access, no client writes)
    match /featureAnalytics/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Organizations
    match /organizations/{orgId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.ownerEmail == request.auth.token.email;
      allow update, delete: if isAuthenticated() && resource.data.ownerEmail == request.auth.token.email;
    }

    // Teams
    match /teams/{teamId} {
      allow read, write: if isAuthenticated();
    }

    // Org Members
    match /orgMembers/{memberId} {
      allow read, write: if isAuthenticated();
    }

    // Org Invoices
    match /orgInvoices/{invoiceId} {
      allow read, write: if isAuthenticated();
    }
  }
}
