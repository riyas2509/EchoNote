rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.role == 'admin' ||
        request.auth.token.platform_admin == true ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function isDocOwner() {
      return isAuthenticated() && request.auth.uid == resource.data.userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128;
    }

    function isProjectOwner(projectId) {
      return isAuthenticated() && get(/databases/$(database)/documents/projects/$(projectId)).data.userId == request.auth.uid;
    }

    function isProjectMember(projectId) {
      return isAuthenticated() && (
        // Check if owner
        (exists(/databases/$(database)/documents/projects/$(projectId)) && 
         get(/databases/$(database)/documents/projects/$(projectId)).data.userId == request.auth.uid) ||
        // Check if member
        exists(/databases/$(database)/documents/projectMembers/$(request.auth.uid + "_" + projectId))
      );
    }

    // User Profiles - strictly isolate tenant & prevent privilege escalation
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      // Users can initialize profile, but cannot self-assign platform admin or elevated roles
      allow create: if isOwner(userId) && 
        (!('role' in request.resource.data) || request.resource.data.role != 'admin') &&
        (!('platform_admin' in request.resource.data) || request.resource.data.platform_admin != true);
      // Users cannot modify role, platform_admin, or authoritative billing fields (handled strictly by server Admin SDK)
      allow update: if isOwner(userId) && 
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'platform_admin', 'claims', 'monthlyMinuteLimit', 'monthlyThinkingLimit']);
      allow delete: if isAdmin();
    }
    
    // Projects
    match /projects/{projectId} {
      allow read: if isAuthenticated() && (
        isAdmin() ||
        resource.data.userId == request.auth.uid || 
        isProjectMember(projectId)
      );
      allow create, update: if isAuthenticated() && (isAdmin() || resource == null || resource.data.userId == request.auth.uid);
      allow delete: if isAdmin(); // Direct client-side deletion forbidden for standard users. Use server-authoritative DELETE /api/projects/:projectId
    }

    // Project Members
    match /projectMembers/{memberId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && 
        (isAdmin() || request.resource.data.userId == request.auth.uid);
      allow delete: if isAuthenticated() && (
        isAdmin() ||
        resource.data.userId == request.auth.uid || 
        isProjectOwner(resource.data.projectId)
      );
    }

    // Invitations
    match /invites/{inviteId} {
      allow read: if true; // Needed for join page validation before login if needed, or just let everyone see if they have the token
      allow create: if isAuthenticated(); // Ideally check if project owner
      allow update: if isAuthenticated() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']);
    }
    
    // Recordings
    match /recordings/{recordingId} {
       allow read: if isAdmin() || isProjectMember(resource.data.group) || isProjectMember(resource.data.projectId) || isOwner(resource.data.userId);
       allow write: if isAuthenticated() && (isAdmin() || resource == null || isProjectMember(request.resource.data.projectId) || isOwner(request.resource.data.userId));
    }
    
    // Transcriptions
    match /transcriptions/{transcriptionId} {
       allow read: if isAdmin() || isProjectMember(resource.data.group) || isProjectMember(resource.data.projectId) || isOwner(resource.data.userId);
       allow write: if isAuthenticated() && (isAdmin() || resource == null || isProjectMember(request.resource.data.projectId) || isOwner(request.resource.data.userId));
    }
    
    // Usage
    match /usage/{userId} {
      allow read: if isOwner(userId);
      allow write: if isOwner(userId);
    }

    // Decision History
    match /decisionHistory/{id} {
      function isValidDecisionHistory(data) {
        return data.userId == request.auth.uid &&
               data.title is string && data.title.size() <= 500 &&
               data.inputType in ['transcript', 'summary'] &&
               data.inputText is string && data.inputText.size() <= 2000000 &&
               data.output is map;
      }
      
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid);
      allow create: if isAuthenticated() && isValidDecisionHistory(request.resource.data) && (request.resource.data.createdAt == request.time || request.resource.data.createdAt == null);
      allow update: if false; // Decisions are immutable record of analysis
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }
    
    // Subscriptions
    match /subscriptions/{id} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow write: if false; // Only server-side or admin
    }

    // Transactions / Billing History
    match /transactions/{id} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid);
      allow write: if isAuthenticated() && (request.resource.data.userId == request.auth.uid);
    }

    // Project Activities
    match /projectActivities/{id} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow delete: if isAuthenticated() && (resource.data.userId == request.auth.uid || isProjectOwner(resource.data.projectId));
    }
    
    // Health Check & Connection Test
    match /healthcheck/{id} {
      allow read: if true;
      allow write: if false;
    }

    match /test/{id} {
      allow read: if true;
      allow write: if false;
    }

    // AI Usage Logs (Admin only, secure read access, no client writes)
    match /aiUsageLogs/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // User Cost Analytics (Admin only, secure aggregate read access, no client writes)
    match /userCostAnalytics/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Extended User Analytics (Admin only, secure aggregate read access, no client writes)
    match /userAnalytics/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Team Analytics (Admin only, secure aggregate read access, no client writes)
    match /teamAnalytics/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Monthly platform analytics (Admin only, secure aggregate read access, no client writes)
    match /monthlyAnalytics/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Feature Analytics (Admin only, secure aggregate read access, no client writes)
    match /featureAnalytics/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Organization Role & Custom Claims Helpers
    function hasOrgClaim(orgId) {
      return isAuthenticated() && request.auth.token.orgId == orgId;
    }

    function isOrgOwner(orgId) {
      return isAuthenticated() && (
        (request.auth.token.orgId == orgId && request.auth.token.orgRole == 'owner') ||
        (exists(/databases/$(database)/documents/organizations/$(orgId)) && 
         (get(/databases/$(database)/documents/organizations/$(orgId)).data.ownerId == request.auth.uid ||
          get(/databases/$(database)/documents/organizations/$(orgId)).data.ownerEmail == request.auth.token.email))
      );
    }

    function isOrgAdmin(orgId) {
      return isAuthenticated() && (
        isOrgOwner(orgId) ||
        (request.auth.token.orgId == orgId && (request.auth.token.orgRole in ['org_admin', 'super_admin', 'admin']))
      );
    }

    function isOrgManager(orgId) {
      return isAuthenticated() && (
        isOrgAdmin(orgId) ||
        (request.auth.token.orgId == orgId && (request.auth.token.orgRole in ['team_manager', 'team_lead', 'manager']))
      );
    }

    function isOrgMember(orgId) {
      return isAuthenticated() && (
        isOrgManager(orgId) ||
        (request.auth.token.orgId == orgId && (request.auth.token.orgRole in ['member', 'viewer', 'guest'])) ||
        (exists(/databases/$(database)/documents/orgMembers/$(request.auth.uid + "_" + orgId)) && 
         get(/databases/$(database)/documents/orgMembers/$(request.auth.uid + "_" + orgId)).data.status == 'active')
      );
    }

    // Organizations
    match /organizations/{orgId} {
      allow read: if isAuthenticated() && (
        isOrgMember(orgId) || 
        isOrgOwner(orgId) || 
        resource.data.ownerId == request.auth.uid || 
        resource.data.ownerEmail == request.auth.token.email
      );
      allow create: if isAuthenticated() && (
        request.resource.data.ownerId == request.auth.uid || 
        request.resource.data.ownerEmail == request.auth.token.email
      );
      allow update: if isAuthenticated() && isOrgAdmin(orgId) && 
        request.resource.data.ownerId == resource.data.ownerId && 
        request.resource.data.ownerEmail == resource.data.ownerEmail;
      allow delete: if false; // Direct client deletion strictly forbidden to prevent orphaned subcollections and identity mappings. Use server-authoritative workflow.

      match /monthlyTrends/{trendId} {
        allow read: if isOrgAdmin(orgId);
        allow write: if false; // Server-side admin only
      }

      match /invoices/{invoiceId} {
        allow read: if isOrgAdmin(orgId);
        allow write: if false;
      }

      match /auditLogs/{logId} {
        allow read: if isOrgAdmin(orgId);
        allow write: if false; // Server-side admin only
      }

      match /integrations/{integrationId} {
        allow read: if isOrgAdmin(orgId);
        allow write: if isOrgAdmin(orgId);
      }
    }

    // Teams
    match /teams/{teamId} {
      allow read: if isAuthenticated() && (isOrgMember(resource.data.orgId) || isOrgOwner(resource.data.orgId));
      allow create, update, delete: if isAuthenticated() && (
        isOrgManager(request.resource.data.orgId) || 
        (resource != null && isOrgManager(resource.data.orgId))
      );
    }

    // Departments
    match /departments/{deptId} {
      allow read: if isAuthenticated() && (isOrgMember(resource.data.orgId) || isOrgOwner(resource.data.orgId));
      allow create, update, delete: if isAuthenticated() && (
        isOrgAdmin(request.resource.data.orgId) || 
        (resource != null && isOrgAdmin(resource.data.orgId))
      );
    }

    // Org Members (authoritatively managed by server-side Admin SDK)
    match /orgMembers/{memberId} {
      allow read: if isAuthenticated() && (
        isOrgMember(resource.data.orgId) || 
        isOrgOwner(resource.data.orgId) || 
        resource.data.userId == request.auth.uid || 
        resource.data.email == request.auth.token.email
      );
      allow write: if false; // Role modifications and memberships are issued authoritatively via backend
    }

    // Org Invoices
    match /orgInvoices/{invoiceId} {
      allow read: if isAuthenticated() && isOrgAdmin(resource.data.orgId);
      allow write: if false;
    }

    // Org Invitations
    match /orgInvitations/{inviteId} {
      allow read: if isAuthenticated() && (
        isOrgAdmin(resource.data.orgId) || 
        resource.data.email == request.auth.token.email
      );
      allow write: if false; // Invitations are handled authoritatively by backend
    }

    // Enterprise Identity Group & Attribute Mappings (Phase 1.7)
    match /orgIdentityMappings/{mappingId} {
      allow read: if isAuthenticated() && (
        isOrgAdmin(resource.data.orgId) || 
        isOrgOwner(resource.data.orgId)
      );
      allow write: if false; // Identity mappings are authoritatively managed via backend endpoints
    }

    // Product Telemetry & Activation Events (Privacy-first, metadata only)
    match /productEvents/{eventId} {
      allow read: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow create: if true; // Allows anonymous and authenticated event tracking
      allow update, delete: if isAdmin();
    }

    match /activationEvents/{eventId} {
      allow read: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow create: if true;
      allow update, delete: if isAdmin();
    }
  }
}
