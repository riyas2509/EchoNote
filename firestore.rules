rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Helper Functions
    // ===============================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() &&
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
          (request.auth.token.email == "riyamshah2509@gmail.com" && request.auth.token.email_verified == true));
    }

    function hasRequiredFields(fields) {
      return request.resource.data.keys().hasAll(fields);
    }

    function hasOnlyAllowedFields(fields) {
      return request.resource.data.keys().hasOnly(fields);
    }

    function uidUnchanged() {
      return !('uid' in request.resource.data) || request.resource.data.uid == request.auth.uid;
    }

    function uidNotModified() {
      return !('uid' in request.resource.data) || request.resource.data.uid == resource.data.uid;
    }

    // ===============================================================
    // Domain Validators
    // ===============================================================

    function isValidUser(data) {
      return hasOnlyAllowedFields(['uid', 'email', 'displayName', 'role', 'plan', 'minutesUsed', 'minutesLimit', 'thinkingUsageCount', 'teamId', 'razorpayCustomerId', 'totalMinutesProcessed', 'createdAt']) &&
             data.uid is string && data.uid.size() < 128 &&
             data.email is string && data.email.size() < 256 &&
             (data.displayName == null || (data.displayName is string && data.displayName.size() < 256)) &&
             data.plan in ['free', 'pro', 'team', 'enterprise'] &&
             (!('minutesUsed' in data) || data.minutesUsed is number) &&
             (!('minutesLimit' in data) || data.minutesLimit is number) &&
             (!('thinkingUsageCount' in data) || data.thinkingUsageCount is number) &&
             (!('teamId' in data) || data.teamId is string);
    }

    function isValidAudioRecord(data) {
      return hasRequiredFields(['id', 'date', 'fileName', 'status', 'ownerUid']) &&
             data.id is string && data.id.size() < 128 &&
             data.ownerUid is string && data.ownerUid.size() < 128 &&
             data.fileName is string && data.fileName.size() < 512 &&
             data.status in ['pending', 'processing', 'completed', 'error', 'draft'];
    }

    function isValidTextRecord(data) {
      return hasRequiredFields(['id', 'date', 'audioUrl', 'ownerUid']) &&
             data.id is string && data.id.size() < 128 &&
             data.ownerUid is string && data.ownerUid.size() < 128 &&
             data.audioUrl is string && data.audioUrl.size() < 2048;
    }

    function isValidProject(data) {
      return hasRequiredFields(['id', 'name', 'ownerId', 'createdAt']) &&
             data.id is string && data.id.size() < 128 &&
             data.name is string && data.name.size() < 256 &&
             data.ownerId is string && data.ownerId.size() < 128 &&
             (!('isDefault' in data) || data.isDefault is bool);
    }

    function isValidDecisionHistory(data) {
      return hasRequiredFields(['userId', 'title', 'inputType', 'inputText', 'output', 'createdAt']) &&
             data.userId is string && data.userId.size() < 128 &&
             data.title is string && data.title.size() < 512 &&
             data.inputType in ['transcript', 'summary'] &&
             data.inputText is string && data.inputText.size() < 100000 &&
             data.output is map;
    }

    // ===============================================================
    // Match Rules
    // ===============================================================

    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) && isValidUser(request.resource.data) && (request.resource.data.role == 'user' || isAdmin()) && (request.resource.data.plan == 'free' || isAdmin());
      allow update: if (isOwner(userId) && 
                       isValidUser(request.resource.data) && 
                       request.resource.data.role == resource.data.role && 
                       (request.resource.data.plan == resource.data.plan || isAdmin()) &&
                       request.resource.data.get('thinkingUsageCount', 0) >= resource.data.get('thinkingUsageCount', 0) &&
                       request.resource.data.get('minutesUsed', 0) >= resource.data.get('minutesUsed', 0)
                      ) || isAdmin();
    }

    match /audioRecords/{recordId} {
      allow read: if isAuthenticated() && (resource.data.ownerUid == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && request.resource.data.ownerUid == request.auth.uid && isValidAudioRecord(request.resource.data);
      allow update: if isAuthenticated() && resource.data.ownerUid == request.auth.uid && isValidAudioRecord(request.resource.data) && request.resource.data.ownerUid == resource.data.ownerUid;
      allow delete: if isAuthenticated() && (resource.data.ownerUid == request.auth.uid || isAdmin());
    }

    match /textRecords/{recordId} {
      allow read: if isAuthenticated() && (resource.data.ownerUid == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && request.resource.data.ownerUid == request.auth.uid && isValidTextRecord(request.resource.data);
      allow update: if isAuthenticated() && resource.data.ownerUid == request.auth.uid && isValidTextRecord(request.resource.data) && request.resource.data.ownerUid == resource.data.ownerUid;
      allow delete: if isAuthenticated() && (resource.data.ownerUid == request.auth.uid || isAdmin());
    }

    match /projects/{projectId} {
      allow read: if isAuthenticated() && (resource.data.ownerId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && request.resource.data.ownerId == request.auth.uid && isValidProject(request.resource.data);
      allow update: if isAuthenticated() && resource.data.ownerId == request.auth.uid && isValidProject(request.resource.data) && request.resource.data.ownerId == resource.data.ownerId && (resource.data.get('isDefault', false) == false || request.resource.data.name == resource.data.name);
      allow delete: if isAuthenticated() && (resource.data.ownerId == request.auth.uid || isAdmin()) && resource.data.get('isDefault', false) == false;
    }

    match /decisionHistory/{historyId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid && isValidDecisionHistory(request.resource.data);
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid && isValidDecisionHistory(request.resource.data) && request.resource.data.userId == resource.data.userId;
      allow delete: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // Default deny
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
